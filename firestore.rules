rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public visitors can read the portfolio configuration
    // Only the authenticated admin (suhail7.dev@gmail.com) can update or write data
    match /portfolio/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'suhail7.dev@gmail.com';
    }
  }
}
